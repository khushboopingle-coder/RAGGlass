SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
DATABASE_URL=sqlite:///./ragglass.db
CHROMA_PERSIST_DIR=./chroma_db

# LLM Provider Configuration ("ollama" or "groq")
LLM_PROVIDER=ollama
GROQ_API_KEY=paste_your_real_key_here

# Security / CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ragglass.vercel.app,https://raglens.vercel.app

# Embedding Provider Configuration ("local" or "huggingface")
EMBEDDING_PROVIDER=local
HF_API_KEY=paste_your_hf_token_here
